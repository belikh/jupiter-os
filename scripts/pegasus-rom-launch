#!/usr/bin/env bash
# pegasus-rom-launch — dispatcher to bubbletea-game-loader
#
# Usage: pegasus-rom-launch <game-file-path>
#   e.g., pegasus-rom-launch 1g1r-nointro-nes/Pac-Man.nes
#   e.g., pegasus-rom-launch curated/exo-dos/Commander Keen.zip
#
# bubbletea-game-loader handles:
# - Checking if game exists on NFS (curated collections)
# - Requesting download from europa API for 1G1R games
# - Polling progress and displaying TUI
# - Launching appropriate emulator when ready

set -euo pipefail

GAME_PATH="${1:-}"
if [[ -z "${GAME_PATH}" ]]; then
    echo "Usage: $0 <game-file-path>" >&2
    exit 2
fi

# Normalize path: if Pegasus passes absolute path like /tank/archive/retro/games/1g1r/nointro-nes/Pac-Man.nes
# convert to relative path 1g1r-nointro-nes/Pac-Man.nes (the format bubbletea-game-loader expects)
if [[ "${GAME_PATH}" == /tank/archive/retro/games/* ]]; then
    GAME_PATH="${GAME_PATH#/tank/archive/retro/games/}"
    # Convert 1g1r/collection/ to 1g1r-collection/ for consistency
    GAME_PATH="${GAME_PATH//1g1r\//1g1r-}"
fi

# Pass to bubbletea-game-loader with no wrapper (shows TUI directly)
exec /usr/local/bin/bubbletea-game-loader "${GAME_PATH}"
