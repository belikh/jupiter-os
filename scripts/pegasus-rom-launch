#!/usr/bin/env bash
# pegasus-rom-launch — dispatcher for curated (NFS) + 1G1R (mirror) games
#
# Usage: pegasus-rom-launch <collection/relative/path>
#   e.g., pegasus-rom-launch curated/exo-dos/Commander Keen.zip
#   e.g., pegasus-rom-launch 1g1r-nointro-nes/Super Mario Bros.nes
#
# Flow:
# 1. Check /tmp/pegasus-cache/ (ephemeral) → instant launch if hit
# 2. Check /var/cache/pegasus-roms/ (persistent) → instant launch if hit
# 3. Check NFS /tank/archive/retro/games/<path>:
#    - If curated ZIP → extract to /tmp/pegasus-cache/ via bubbletea-game-loader
#    - If direct ROM on NFS → launch directly from NFS
#    - If not on NFS (1G1R) → download from Myrient to /var/cache/pegasus-roms/ via TUI
# 4. Launch appropriate emulator with cached file

set -euo pipefail

ROM_PATH="${1:-}"
if [[ -z "${ROM_PATH}" ]]; then
    echo "Usage: $0 <collection/relative/path>" >&2
    exit 2
fi

NFS_MOUNT="/tank/archive"
TMP_CACHE="/tmp/pegasus-cache"
PERSISTENT_CACHE="/var/cache/pegasus-roms"
GAMES_ROOT="${NFS_MOUNT}/retro/games"

GAME_NAME="$(basename "${ROM_PATH}" | sed 's/\.[^.]*$//')"
GAME_NAME_SAFE="$(echo "${GAME_NAME}" | sed 's/[^a-zA-Z0-9._-]/_/g')"

mkdir -p "${TMP_CACHE}" "${PERSISTENT_CACHE}"

log() { echo "[$(date '+%H:%M:%S')] $*" >&2; }

# 1. Check ephemeral cache first
if [[ -e "${TMP_CACHE}/${GAME_NAME_SAFE}" ]]; then
    log "Cache HIT (ephemeral): ${GAME_NAME}"
    exec launch-emulator "${TMP_CACHE}/${GAME_NAME_SAFE}" "${ROM_PATH}"
fi

# 2. Check persistent cache
if [[ -e "${PERSISTENT_CACHE}/${GAME_NAME_SAFE}" ]]; then
    log "Cache HIT (persistent): ${GAME_NAME}"
    exec launch-emulator "${PERSISTENT_CACHE}/${GAME_NAME_SAFE}" "${ROM_PATH}"
fi

# 3. Check NFS
NFS_PATH="${GAMES_ROOT}/${ROM_PATH}"
if [[ -e "${NFS_PATH}" ]]; then
    log "Found on NFS: ${NFS_PATH}"

    if [[ "${ROM_PATH}" == *.zip ]] || [[ "${ROM_PATH}" == *.ZIP ]] || [[ "${ROM_PATH}" == *.7z ]] || [[ "${ROM_PATH}" == *.7Z ]]; then
        # Curated archive → extract to ephemeral cache
        CACHE_DIR="${TMP_CACHE}/${GAME_NAME_SAFE}"
        log "Curated archive detected, extracting to ${CACHE_DIR}"
        mkdir -p "${CACHE_DIR}"

        /usr/local/bin/bubbletea-game-loader \
            --src "${ROM_PATH}" \
            --dst "${CACHE_DIR}" \
            --operation extract \
            --nfs-mount "${NFS_MOUNT}" \
            --title "${GAME_NAME}"

        exec launch-emulator "${CACHE_DIR}" "${ROM_PATH}"
    else
        # Direct ROM on NFS → launch directly
        log "Direct ROM on NFS, launching from ${NFS_PATH}"
        exec launch-emulator "${NFS_PATH}" "${ROM_PATH}"
    fi
else
    # 4. Not on NFS → 1G1R, download from Myrient
    log "Not on NFS (1G1R), downloading to persistent cache"
    CACHE_FILE="${PERSISTENT_CACHE}/${GAME_NAME_SAFE}"

    /usr/local/bin/bubbletea-game-loader \
        --src "${ROM_PATH}" \
        --dst "${CACHE_FILE}" \
        --operation download \
        --nfs-mount "${NFS_MOUNT}" \
        --title "${GAME_NAME}"

    exec launch-emulator "${CACHE_FILE}" "${ROM_PATH}"
fi


# --- Internal: determine emulator and launch ---
launch-emulator() {
    local cache_path="$1"
    local rom_path="$2"

    # Determine emulator from collection path
    local emulator
    case "${rom_path}" in
        curated/exo-dos/*)
            emulator="dosbox-staging"
            ;;
        curated/exo-win3x/*)
            emulator="dosbox-x"
            ;;
        curated/c64-dreams/*)
            emulator="vice"
            ;;
        curated/oneload64/*)
            emulator="vice"
            ;;
        curated/exo-if/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/gargoyle_libretro.so"
            ;;
        curated/exo-scummvm/*)
            emulator="scummvm"
            ;;
        curated/exo-appleiigs/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/gsplus_libretro.so"
            ;;
        curated/exo-demos/*)
            emulator="dosbox-staging"
            ;;
        curated/exo-win9x/*)
            emulator="pcem"
            ;;
        curated/megaags/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/uae_libretro.so"
            ;;
        curated/tosec/*)
            emulator="retroarch"
            ;;
        1g1r-nointro-nes/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/nestopia_libretro.so"
            ;;
        1g1r-nointro-snes/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/snes9x_libretro.so"
            ;;
        1g1r-nointro-gb/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/gambatte_libretro.so"
            ;;
        1g1r-nointro-gbc/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/gambatte_libretro.so"
            ;;
        1g1r-nointro-gba/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/mgba_libretro.so"
            ;;
        1g1r-nointro-n64/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/mupen64plus_next_libretro.so"
            ;;
        1g1r-nointro-ds/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/melonDS_libretro.so"
            ;;
        1g1r-redump-ps1/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/duckstation_libretro.so"
            ;;
        1g1r-redump-ps2/*)
            emulator="pcsx2"
            ;;
        1g1r-redump-psp/*)
            emulator="ppsspp"
            ;;
        1g1r-redump-saturn/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/yabause_libretro.so"
            ;;
        1g1r-redump-dreamcast/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/flycast_libretro.so"
            ;;
        1g1r-redump-gamecube/*|1g1r-redump-wii/*)
            emulator="dolphin-emu"
            ;;
        1g1r-redump-xbox/*)
            emulator="retroarch -L /run/current-system/sw/lib/libretro/xemu_libretro.so"
            ;;
        1g1r-tosec/*)
            emulator="retroarch"
            ;;
        *)
            emulator="retroarch"
            ;;
    esac

    log "Launching with: ${emulator} ${cache_path}"
    exec ${emulator} "${cache_path}"
}