result
result-*
.direnv/

# VM disk images + OVMF EFI variable store (build artifacts from
# `make test-<host>` / scripts/boot-smoke.sh; vmVariant boots UEFI)
*.qcow2
*-efi-vars.fd

# Python bytecode (scripts/ are run in place)
__pycache__/
*.pyc

# Session scratch (build logs, findings, draft PR bodies). Never committed;
# nothing in the flake reads from here.
temp/

# Throwaway dev scripts (DOM dumper, HA autologin hack, one-off installer ISO).
# Like temp/, never meant to be tracked.
scratchpad/

# open-ultracode runtime state -- timestamps churn every session and nothing
# in the repo reads it (kept local so a catch-all commit cannot sweep it up).
.opencode/*/state/

# Arcade-webapp fixture tree (make fixture-arcade): deterministic generated
# output. Only the README and the canonical DATs
# (pkgs/arcade-webapp/testdata/dats/) are committed.
tests/fixtures/arcade/incoming/
tests/fixtures/arcade/verified/
tests/fixtures/arcade/reports/
