     http::header::CacheControl(vec![http::header::CacheDirective::NoStore])
 }
 
+/// Cache-Control for a complete NAR response.
+///
+/// NARs are content-addressed and therefore immutable, so they are normally
+/// cacheable for a year. Above `max_cacheable` bytes we ask caches not to store
+/// the response at all: a CDN that refuses objects over some size can otherwise
+/// store a truncated transfer as though it were complete, and then serve that
+/// corrupt body until the entry expires. `max_cacheable == 0` disables the
+/// limit and restores the unconditional one-year `max-age`.
+fn cache_control_for_nar(nar_size: u64, max_cacheable: u64) -> http::header::CacheControl {
+    if max_cacheable > 0 && nar_size > max_cacheable {
+        cache_control_no_store()
+    } else {
+        cache_control_max_age_1y()
+    }
+}
