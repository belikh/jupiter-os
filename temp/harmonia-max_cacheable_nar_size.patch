+# Serve NARs larger than this many bytes with `Cache-Control: no-store`
+# instead of the usual one-year `max-age`, so a CDN in front of harmonia does
+# not try to store them. 0 (the default) disables the limit.
+#
+# Set this when your CDN has a maximum cacheable object size. An oversized
+# response that is truncated in transit can otherwise be stored as if it were
+# complete, after which every request is served a corrupt NAR until the entry
+# expires. CDN cache rules generally match on the request, so they cannot see
+# the response size -- the origin is the only place this can be decided.
+#
+# Example: Cloudflare's limit is 512 MB on Free/Pro/Business plans.
+# max_cacheable_nar_size = 536870912
